{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/booky",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate" }
      ]
    },
    {
      "source": "/booky/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate" }
      ]
    },
    {
      "source": "/:path+.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/books-like/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/daily",
      "destination": "/booky",
      "permanent": true
    },
    {
      "source": "/daily/:path*",
      "destination": "/booky/:path*",
      "permanent": true
    },
    {
      "source": "/books-like/acotar",
      "destination": "/books-like/a-court-of-thorns-and-roses",
      "permanent": true
    },
    {
      "source": "/books-like/fbaa",
      "destination": "/books-like/from-blood-and-ash",
      "permanent": true
    },
    {
      "source": "/books-like/agggtm",
      "destination": "/books-like/a-good-girls-guide-to-murder",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/books-like/:slug*",
      "destination": "/"
    },
    {
      "source": "/genre/:slug*",
      "destination": "/"
    },
    {
      "source": "/mood/:slug*",
      "destination": "/"
    }
  ]
}
