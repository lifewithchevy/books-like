{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/:path+.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/books-like/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/daily",
      "destination": "/booky",
      "permanent": true
    },
    {
      "source": "/daily/:path*",
      "destination": "/booky/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/books-like/:slug*",
      "destination": "/"
    },
    {
      "source": "/genre/:slug*",
      "destination": "/"
    },
    {
      "source": "/mood/:slug*",
      "destination": "/"
    }
  ]
}
